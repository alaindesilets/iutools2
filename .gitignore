# Build output
build/
out/

# Gradle
.gradle/
.gradle-home/
gradle-app.setting
!gradle-wrapper.jar
!gradle-wrapper.properties

# Kotlin
.kotlin/

# Distributable packages (large binaries, rebuilt from source — not tracked)
dist/

# IDE
.idea/
*.iml
.vscode/
# JDT/Gradle-extension project-sync artifact: copies .kt "resources" it
# can't compile into a classic Eclipse-style bin/ output folder.
cli/bin/
fst/bin/

# Editor swap files
*.swp

# macOS
.DS_Store

# Android / local machine paths
local.properties
*.apk
*.aab

# Nunavut Hansard corpus: source archive (202 MiB) and the generated SQLite
# index (250-350 MiB) are build inputs/outputs for tools/build_hansard_index.py,
# never committed -- see tools/README-hansard.md for how to (re)generate and
# push them to a device.
/Nunavut-Hansard-Inuktitut-English-Parallel-Corpus-*.tgz
/tools/hansard-corpus/
/tools/hansard.db
/tools/hansard.db.gz

# FST prototypes (doc/fst-analyzer-plan.md): compiled transducer binaries
# are build output from the .lexc sources, regenerated with hfst-lexc /
# hfst-fst2fst -- never committed.
/tools/fst/*.hfst
/tools/fst/*.hfstol

# Python bytecode cache (tools/fst/*.py)
__pycache__/

