<?xml version="1.0" encoding="utf-8"?>
<!--
  Without this, Android 8+ launchers treat ic_launcher.png as a legacy icon
  and auto-generate an adaptive shape around it, typically insetting it
  well below the standard 66% safe zone to stay safely clear of unknown
  content, which is why the icon looked much smaller than intended on a
  themed home screen. Declaring the layers explicitly lets the foreground
  fill the full safe zone instead.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
