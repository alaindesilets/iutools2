{
  "name": "iutools2 (Claude Code sandbox)",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "TZ": "${localEnv:TZ:America/Toronto}"
    },
    // Build the whole container as x86_64 rather than native ARM64, so
    // Google's x86_64-only Android build tools (aapt2 in particular) run
    // as genuinely native binaries inside it. Relies on Docker Desktop's
    // "Use Rosetta for x86/amd64 emulation on Apple Silicon" setting for
    // reasonable performance -- check that's enabled in Docker Desktop's
    // settings if this ends up slow. See project memory
    // "android-build-blocker-devcontainer" for why this replaced an
    // earlier, more fragile qemu-user-static/binfmt attempt.
    "options": ["--platform=linux/amd64"]
  },
  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {
      "version": "latest"
    }
  },
  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW",
    "--platform=linux/amd64",
    // Derive the container name from the opened folder rather than leaving
    // it random. This also means each git worktree of this project (opened
    // in its own VS Code window/container) gets its own uniquely-named
    // container automatically, so they can run side by side without a name
    // collision — Docker refuses two containers sharing one name.
    "--name", "${localWorkspaceFolderBasename}-claude-sandbox"
  ],
  "postCreateCommand": "npm install --prefix /home/vscode/.claude/local @anthropic-ai/claude-code@latest",
  "remoteEnv": {
    "PATH": "/home/vscode/.claude/local/node_modules/.bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "fwcd.kotlin",
        "vscjava.vscode-gradle",
        "eamodio.gitlens"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "remoteUser": "vscode",
  "mounts": [
    // Named with a fixed per-project slug ("iutools-mobile") rather than
    // "-${devcontainerId}": devcontainerId is derived from the opened
    // folder's path, so every git worktree would otherwise get its own
    // separate volume and have to re-authenticate Claude Code, lose shell
    // history, or re-download the Gradle/Android SDK caches. A fixed name
    // means all worktrees of this project share these across their
    // separate containers.
    "source=iutools-mobile-claude-code-bashhistory,target=/commandhistory,type=volume",
    "source=iutools-mobile-claude-code-config,target=/home/vscode/.claude,type=volume",
    "source=iutools-mobile-gradle-cache,target=/home/vscode/.gradle,type=volume",
    "source=iutools-mobile-android-sdk,target=/opt/android-sdk,type=volume",
    // Re-mount .devcontainer read-only, nested inside the (writable)
    // workspace bind above. Without this, Claude running inside the
    // container could edit devcontainer.json/Dockerfile/init-firewall.sh —
    // no immediate effect, but a weakened config would silently take over
    // on the next container rebuild. This only restricts writes through the
    // container's mount point; the files are still normal, freely editable
    // files on the host.
    "source=${localWorkspaceFolder}/.devcontainer,target=/workspace/.devcontainer,type=bind,readonly",
    // Running multiple agents in parallel via git worktrees (see the
    // README section of the same name)? A worktree's .git is just a text
    // file pointing at an absolute host path inside the MAIN repo's .git
    // (e.g. "gitdir: /Users/you/Documents/iutools-mobile/.git/worktrees/wt1"),
    // which isn't visible inside the container since only /workspace is
    // mounted — every git command in the worktree fails with "fatal: not a
    // git repository: (null)" otherwise. Fix: bind the main repo's .git
    // into the container at that SAME absolute path, so git resolves it
    // correctly regardless of which worktree is currently open.
    "source=${localWorkspaceFolder}/../iutools2/.git,target=${localWorkspaceFolder}/../iutools2/.git,type=bind,consistency=cached"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    "ANDROID_HOME": "/opt/android-sdk",
    "ANDROID_SDK_ROOT": "/opt/android-sdk"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
  "workspaceFolder": "/workspace",
  "postStartCommand": "sudo /usr/local/bin/project-init-firewall.sh",
  "waitFor": "postStartCommand"
}
