# Build output
build/
out/

# Gradle
.gradle/
.gradle-home/
gradle-app.setting
!gradle-wrapper.jar
!gradle-wrapper.properties

# Kotlin
.kotlin/

# Distributable packages (large binaries, rebuilt from source — not tracked)
dist/

# IDE
.idea/
*.iml
.vscode/
# JDT/Gradle-extension project-sync artifact: copies each module's sources /
# "resources" it can't compile into a classic Eclipse-style bin/ output
# folder (cli/bin/, fst/bin/, ...).
*/bin/
# Stray compiled classes -- normally only under build/ or */bin/ (both
# ignored above), but catch them anywhere.
*.class

# Editor swap files
*.swp

# macOS
.DS_Store

# Android / local machine paths
local.properties
*.apk
*.aab

# Nunavut Hansard corpus: source archive (202 MiB) and the generated SQLite
# index (250-350 MiB) are build inputs/outputs for tools/build_hansard_index.py,
# never committed -- see tools/README-hansard.md for how to (re)generate and
# push them to a device.
/Nunavut-Hansard-Inuktitut-English-Parallel-Corpus-*.tgz
/tools/hansard-corpus/
/tools/hansard.db
/tools/hansard.db.gz

# FST prototypes (doc/dev/plans/fst-analyzer-plan.md): compiled transducer
# binaries are build output from the .lexc sources, regenerated with
# hfst-lexc / hfst-fst2fst -- never committed.
/data/grammar/fst/*.hfst
/data/grammar/fst/*.hfstol

# FST re-ranker experiment scratch: large feature tables (reranker_table.jsonl
# ~18 MB), CV detail dumps, run logs, lexicon backups -- regenerated by
# build_reranker_table.py and the reranker_*.py scripts, never committed.
/data/grammar/fst/scratchpad/

# Python bytecode cache (data/grammar/fst/*.py)
__pycache__/

# Shared / private / licensed reference data. Lives read-only under /shared/ref
# in the agent containers (recovered Living Dictionary, gov.nu.ca crawl, raw
# .bak / corpus archives) and must never be committed -- see AGENTS.md "Shared
# reference data (/shared)" and the hooks/pre-commit guard. These lines also
# catch a stray copy pulled into the working tree.
/shared/
**/living-dictionary-recovery/
**/gov-nu-ca-crawl/
*.bak

